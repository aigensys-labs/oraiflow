FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser

# pyproject.toml is the dependency source of truth. The release candidate does
# not yet ship uv.lock; resolve it during build until maintainers commit the
# reviewed lockfile, after which `uv lock` can be removed from this layer.
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir uv==0.10.0 \
    && uv lock \
    && uv sync --locked --no-dev

COPY shared ./shared
COPY services ./services
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh && mkdir -p /run/oraiflow && chown -R appuser:appuser /app /run/oraiflow

USER appuser
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
