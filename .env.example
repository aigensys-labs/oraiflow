# ============================================================================
# ORAIflow Core v0.7.7 — local/self-hosted synthetic demo configuration
# Copy to .env. Never commit .env, API tokens, private keys or real certificates.
# All default banking data is synthetic. All default secrets are intentionally weak and local-only.
# This is NOT a live banking connector; never expose this configuration to a shared network.
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL — synthetic reference ledger and ORAIflow operational state
# ---------------------------------------------------------------------------
POSTGRES_USER=oraiflow
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=oraiflow
DATABASE_URL=postgresql+psycopg://oraiflow:local-only-change-me@postgres:5432/oraiflow
# MCP has a separate SELECT-only login. Leave MCP_DATABASE_URL blank to derive
# it from MCP_DATABASE_PASSWORD; URL-encode reserved characters if overriding it.
MCP_DATABASE_PASSWORD=local-only-read-change-me
MCP_DATABASE_URL=
# LangGraph checkpoint principal is restricted to the oraiflow_agent schema.
AGENT_CHECKPOINT_PASSWORD=local-agent-checkpoint-change-me
AGENT_CHECKPOINT_DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true

# Demo identity only. Never use these values as production identity claims.
DEMO_USER_ID=user-001
DEMO_TENANT_ID=tenant-demo
DEMO_DISPLAY_NAME=Alex Morgan
# Name shown in the left sidebar workspace switcher. Presentation only.
DEMO_WORKSPACE_NAME="Atlas Fintech"
# Adds 28 stable-ID synthetic transactions across roughly 63 days for monthly analysis demos.
DEMO_TRANSACTION_HISTORY_ENABLED=true
# Updates only the known synthetic txn-001 payroll label and amount on migration.
DEMO_SALARY_EMPLOYER=Northstar Labs
# Monthly synthetic EUR salary credit in minor units (1100000 = €11,000.00).
DEMO_SALARY_AMOUNT_MINOR=1100000
DEMO_SCA_APPROVED=true
DEMO_SCA_CODE=123456
DEMO_MAX_TRANSFER=1000.00
DEMO_POLICY_VERSION=demo-transfer-policy-v1
PREVIEW_TTL_MINUTES=5
# Local demo only. Replace with a high-entropy secret from a secret manager outside development.
PREVIEW_SIGNING_SECRET=local-preview-signing-secret-change-me

# ---------------------------------------------------------------------------
# Mandatory MCP capability boundary (internal Docker network)
# ---------------------------------------------------------------------------
MCP_URL=http://mcp:8100/mcp
MCP_ACCESS_TOKEN=local-mcp-token-change-me
# Customer-local calendar boundary for relative transaction-analysis periods (IANA timezone).
ORAI_BUSINESS_TIMEZONE=Europe/Prague

# Internal-only Agent Runtime call; never expose this service to the browser.
AGENT_RUNTIME_URL=http://agent-runtime:8101
AGENT_RUNTIME_INTERNAL_TOKEN=local-agent-runtime-token-change-me
AGENT_RUNTIME_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# LLM provider
# demo | ollama | openai | anthropic
# Start in demo mode (no cloud key required), then select a real provider.
# For Open WebUI / Ollama OpenAI-compatible endpoints, use LLM_PROVIDER=openai.
# ---------------------------------------------------------------------------
LLM_PROVIDER=demo
# Required explicit opt-in before sending minimized banking context to OpenAI/Anthropic.
LLM_EXTERNAL_DATA_APPROVED=false
LLM_MODEL=gpt-oss:20b
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
# Bounded model time budget across interpretation and final response composition.
LLM_TURN_MODEL_BUDGET_SECONDS=70
LLM_INTERPRETATION_TIMEOUT_SECONDS=50
LLM_RESPONSE_TIMEOUT_SECONDS=15
# SSE comment keepalives preserve long-running AG-UI connections without
# cancelling the in-flight model/provider operation.
AGENT_AGUI_KEEPALIVE_SECONDS=15
# Progressive publication of completed deterministic/resource responses.
AGENT_SCRIPTED_STREAM_CHUNK_CHARS=12
AGENT_SCRIPTED_STREAM_DELAY_MS=35

# Interpretation confidence: observe records the four model scores without
# enforcing thresholds. Switch to enforce only after calibration on labelled data.
ORAI_CONFIDENCE_GATE_MODE=observe
ORAI_INTENT_CONFIDENCE_THRESHOLD=
ORAI_SLOT_CONFIDENCE_THRESHOLD=
ORAI_ENTITY_CONFIDENCE_THRESHOLD=
ORAI_CAPABILITY_CONFIDENCE_THRESHOLD=

# Native Ollama (used only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m

# OpenAI or OpenAI-compatible gateway (used only when LLM_PROVIDER=openai)
# Base URL is the API prefix before /chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (used only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Docker container DNS for outbound model-provider / private HTTPS calls
# Set these to DNS resolvers reachable from the Docker host/network.
# ---------------------------------------------------------------------------
API_DNS_SERVER_1=1.1.1.1
API_DNS_SERVER_2=8.8.8.8

# ---------------------------------------------------------------------------
# Public CA trust for outbound HTTPS from backend containers
# Put your public CA certificate in ./certs/ using this filename.
# CUSTOM_CA_FILE is a HOST path; CUSTOM_CA_CONTAINER_FILE is container path.
# Do not put private keys here. The directory is mounted read-only.
# ---------------------------------------------------------------------------
CUSTOM_CA_FILE=./certs/internal-ca.crt
CUSTOM_CA_CONTAINER_FILE=/run/oraiflow/custom-ca.crt
CA_BUNDLE_PATH=/run/oraiflow/ca-bundle.pem

# ---------------------------------------------------------------------------
# Service configuration
# ---------------------------------------------------------------------------
# Host ports bind to loopback by default. Only change API_BIND_ADDRESS when
# you deliberately need remote access and have added network-level protection.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=oraiflow-transfers
# Current adapter is synthetic PostgreSQL only; no live institution adapter exists.
BANK_LEDGER_ADAPTER=postgres


# Synthetic loan liability shown separately from deposit accounts (EUR minor units)
DEMO_LOAN_ENABLED=false
DEMO_LOAN_PRINCIPAL_MINOR=500000
DEMO_LOAN_APR_BPS=690
DEMO_LOAN_TERM_MONTHS=24
